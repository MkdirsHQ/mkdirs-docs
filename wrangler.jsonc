{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mkdocs",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "docs.mksaas.link",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
